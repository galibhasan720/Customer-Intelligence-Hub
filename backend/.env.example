APP_ENV=local
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173
# Local Docker Postgres (docker compose up -d postgres)
DATABASE_URL=postgresql://seatflow:seatflow@localhost:5432/seatflow
JWT_SECRET=dev-local-secret-change-me
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080
# Kept for future Supabase cloud mode (unused in local auth)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
